@model CrudUserPageViewModel

@{
    ViewData["Title"] = "User CRUD";
}

<div class="section-heading">
    <p class="eyebrow">Master CRUD</p>
    <h1>User 管理</h1>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert alert-info" role="status">@Model.Message</div>
}

<div class="row g-4">
    <section class="col-12 col-lg-5">
        <div class="report-input-panel">
            <h2 class="h5">@(Model.Input.Id == 0 ? "新規登録" : "編集")</h2>

            <form asp-action="SaveUser" asp-controller="Master" method="post" class="mt-3">
                <input asp-for="Input.Id" type="hidden" />

                <div class="mb-3">
                    <label asp-for="Input.UserName" class="form-label">ユーザー名</label>
                    <input asp-for="Input.UserName" class="form-control" autocomplete="off" />
                    <span asp-validation-for="Input.UserName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.CompanyId" class="form-label">会社</label>
                    <select asp-for="Input.CompanyId" class="form-select">
                        @foreach (var company in Model.Companies)
                        {
                            <option value="@company.Value" selected="@company.Selected">@company.Text</option>
                        }
                    </select>
                    <span asp-validation-for="Input.CompanyId" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">保存</button>
                    <a asp-action="Users" class="btn btn-outline-secondary">クリア</a>
                </div>
            </form>
        </div>
    </section>

    <section class="col-12 col-lg-7">
        <div class="report-input-panel">
            <h2 class="h5">一覧</h2>

            <table class="table table-striped align-middle mt-3">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>ユーザー名</th>
                        <th>会社</th>
                        <th class="text-end">操作</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var user in Model.Users)
                {
                    <tr>
                        <td>@user.Id</td>
                        <td>@user.UserName</td>
                        <td>@(user.Company?.CompanyName ?? "")</td>
                        <td class="text-end">
                            <a asp-controller="Report" asp-action="UserFavorite" asp-route-id="@user.Id" class="btn btn-sm btn-outline-dark">帳票登録</a>
                            <a asp-action="Users" asp-route-editId="@user.Id" class="btn btn-sm btn-outline-primary">編集</a>
                            <form asp-action="DeleteUser" asp-controller="Master" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@user.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">削除</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
