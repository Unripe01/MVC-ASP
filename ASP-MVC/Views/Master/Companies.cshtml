@model CrudCompanyPageViewModel

@{
    ViewData["Title"] = "Company CRUD";
}

<div class="section-heading">
    <p class="eyebrow">Master CRUD</p>
    <h1>Company 管理</h1>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert alert-info" role="status">@Model.Message</div>
}

<div class="row g-4">
    <section class="col-12 col-lg-5">
        <div class="report-input-panel">
            <h2 class="h5">@(Model.Input.Id == 0 ? "新規登録" : "編集")</h2>

            <form asp-action="SaveCompany" asp-controller="Master" method="post" class="mt-3">
                <input asp-for="Input.Id" type="hidden" />

                <div class="mb-3">
                    <label asp-for="Input.CompanyName" class="form-label">会社名</label>
                    <input asp-for="Input.CompanyName" class="form-control" autocomplete="off" />
                    <span asp-validation-for="Input.CompanyName" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">保存</button>
                    <a asp-action="Companies" class="btn btn-outline-secondary">クリア</a>
                </div>
            </form>
        </div>
    </section>

    <section class="col-12 col-lg-7">
        <div class="report-input-panel">
            <h2 class="h5">一覧</h2>

            <table class="table table-striped align-middle mt-3">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>会社名</th>
                        <th class="text-end">操作</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var company in Model.Companies)
                {
                    <tr>
                        <td>@company.Id</td>
                        <td>@company.CompanyName</td>
                        <td class="text-end">
                            <a asp-action="Companies" asp-route-editId="@company.Id" class="btn btn-sm btn-outline-primary">編集</a>
                            <form asp-action="DeleteCompany" asp-controller="Master" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@company.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">削除</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
